  "files": {
    "src/defaults.ts": "export const DEFAULT_TIMEOUT = 4100;\n",
    "src/settings.ts": "import { DEFAULT_TIMEOUT } from './defaults.js';\nexport function settings(env: Record<string, string | undefined>, overrides: { timeoutMs?: number }) {\n  const timeoutMs = overrides.timeoutMs ?? Number(env.LABEL_TIMEOUT_MS ?? DEFAULT_TIMEOUT);\n  return { timeoutMs };\n}\n",
    "src/main.ts": "import { settings } from './settings.js';\nimport { sendLabel } from './transport.js';\nexport function boot(env: Record<string, string | undefined>) {\n  const options = settings(env, { timeoutMs: 7300 });\n  return sendLabel(options.timeoutMs);\n}\n",
    "src/transport.ts": "export function sendLabel(timeoutMs: number) { return { path: \"/labels\", timeoutMs }; }\n",
    "deploy/service.env": "LABEL_TIMEOUT_MS=6200\n",
    "package.json": "{\n  \"name\": \"parcel-label-gateway\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"start\": \"tsx src/main.ts\",\n    \"typecheck\": \"tsc --noEmit\"\n  },\n  \"devDependencies\": {\n    \"tsx\": \"4.19.2\",\n    \"typescript\": \"5.7.2\"\n  }\n}\n",
    "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"NodeNext\",\n    \"moduleResolution\": \"NodeNext\",\n    \"strict\": true\n  },\n  \"include\": [\n    \"src/**/*.ts\"\n  ]\n}\n",
    "README.md": "# parcel-label-gateway\n\nSmall service for parcel label gateway.\n\nOperational entry: `src/main.ts`. Paths are relative to the project root.\n"
