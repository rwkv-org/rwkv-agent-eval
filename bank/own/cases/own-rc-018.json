  "category": "查找阅读-代码",
  "files": {
    "cmd/lease/main.go": "package main\nimport (\"fmt\"; \"os\"; \"warehouse-lease-daemon/internal/config\")\nfunc main() { fmt.Println(config.LeaseSeconds(os.Getenv, 37)) }\n",
    "internal/config/lease.go": "package config\nimport \"strconv\"\nconst DefaultLeaseSeconds = 61\nfunc LeaseSeconds(getenv func(string) string, override int) int {\n    value := DefaultLeaseSeconds\n    if raw := getenv(\"LEASE_SECONDS\"); raw != \"\" {\n        if parsed, err := strconv.Atoi(raw); err == nil { value = parsed }\n    }\n    if override > 0 { value = override }\n    return value\n}\n",
    "deploy/lease.env": "LEASE_SECONDS=83\n",
    "config/lease.toml": "[lease]\nowner = \"loading-bay\"\n",
    "scripts/build.sh": "#!/bin/sh\nset -eu\ngo build -o /tmp/warehouse-lease ./cmd/lease\n",
    "go.mod": "module warehouse-lease-daemon\n\ngo 1.22\n",
    "README.md": "# warehouse-lease-daemon\n\nSmall service for warehouse lease daemon.\n\nOperational entry: `cmd/lease/main.go`. Paths are relative to the project root.\n"
  },
