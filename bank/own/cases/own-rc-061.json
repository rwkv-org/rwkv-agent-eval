  "category": "查找阅读-代码",
  "files": {
    "bin/unmount.sh": "#!/bin/bash\nset -u\nsource lib/guard.sh\nunmount_main() {\n    source config/volume.env\n    check_volume_safe\n    local rc=$?\n    if [ \"$rc\" -ne 0 ]; then\n        return \"$rc\"\n    fi\n    printf 'unmount %s\\n' \"$VOLUME_NAME\"\n}\nunmount_main\n",
    "lib/guard.sh": "source lib/log.sh\ncheck_volume_safe() {\n    if [ \"$VOLUME_MODE\" != \"managed\" ]; then\n        return 0\n    fi\n    if [ \"$VOLUME_CLIENTS\" -gt 0 ]; then\n        emit_guard_error VOLUME_HAS_CLIENTS\n        return 46\n    fi\n    return 0\n}\n",
    "lib/log.sh": "emit_guard_error() {\n    printf 'guard: %s\\n' \"$1\" >&2\n}\n",
    "config/volume.env": "VOLUME_NAME=archive-west\nVOLUME_MODE=managed\nVOLUME_CLIENTS=3\n",
    "docs/operation.md": "# Unmount guard\nOnly managed volumes use the client-count check. The entry point preserves the guard status.\n",
    "README.md": "# volume-unmount-guard\n\n路径均相对于仓库根目录。运维入口和库函数分开维护。\n"
  },
