  "files": {
    "src/server.py": "from .routes import CORE, WRITABLE\nfrom .plugins import plugin_routes\n\ndef routes(env):\n    result = dict(CORE)\n    if env.get(\"ROOM_WRITE\") == \"1\":\n        result.update(WRITABLE)\n    result.update(plugin_routes())\n    return result\n",
