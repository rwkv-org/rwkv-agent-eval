  "category": "查找阅读-代码",
  "files": {
    "bin/publish.sh": "#!/bin/sh\nset -eu\n. ./lib/publish.sh\npublish_bundle \"$1\"\n",
    "lib/publish.sh": " . ./conf/channel.env\n. \"$CHANNEL_HELPER\"\npublish_bundle() {\n    channel_send \"$1\"\n}\n",
    "conf/channel.env": "CHANNEL_HELPER=./lib/channels/edge.sh\n",
    "lib/channels/edge.sh": "channel_send() {\n    printf 'edge-upload %s\\n' \"$1\"\n}\n",
    "lib/channels/stable.sh": " . ./lib/publish.sh\nchannel_send() {\n    printf 'stable-upload %s\\n' \"$1\"\n}\n",
    "docs/channels.md": "# Channels\nStable is kept for the previous fleet; channel.env selects the helper loaded by the publisher.\n",
    "README.md": "# release-bundle-publisher\n\nSmall service for release bundle publisher.\n\nOperational entry: `bin/publish.sh`. Paths are relative to the project root.\n"
  },
