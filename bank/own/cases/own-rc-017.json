    "src/message.ts": "import { collectHandles } from './mentions.js';\nexport function routeMessage(body: string) {\n  return { targets: collectHandles(body), body };\n}\n",
    "src/mentions.ts": "export function collectHandles(body: string) {\n  const matches = body.matchAll(/@([a-z][a-z0-9_]{2,19})/gi);\n  return [...new Set(Array.from(matches, match => match[1].toLowerCase()))];\n}\nexport function hasBroadcast(body: string) { return body.includes('@all'); }\n",
    "src/audit.ts": "export function auditTag(room: string) { return `room:${room}`; }\n",
    "config/rooms.json": "{\"default\":\"operations\",\"allowBroadcast\":false}\n",
