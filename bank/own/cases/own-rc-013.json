    "src/cli.ts": "import { baseCommands } from './base.js';\nimport { cacheCommands } from './cache.js';\nexport function commandTable(env: Record<string, string | undefined>) {\n  return env.MAP_CACHE === 'on' ? [...baseCommands, ...cacheCommands] : baseCommands;\n}\n",
    "src/base.ts": "export const baseCommands = [\n  { name: 'render', run: 'renderMap' },\n  { name: 'bounds', run: 'showBounds' },\n  { name: 'legend', run: 'printLegend' },\n];\n",
    "src/cache.ts": "export const cacheCommands = [\n  { name: 'cache-warm', run: 'warmTiles' },\n  { name: 'cache-drop', run: 'dropTiles' },\n];\n",
    "config/local.env": "MAP_CACHE=off\n",
    "package.json": "{\n  \"name\": \"trail-map-command-kit\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"start\": \"tsx src/cli.ts\",\n    \"typecheck\": \"tsc --noEmit\"\n  },\n  \"devDependencies\": {\n    \"tsx\": \"4.19.2\",\n    \"typescript\": \"5.7.2\"\n  }\n}\n",
    "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"NodeNext\",\n    \"moduleResolution\": \"NodeNext\",\n    \"strict\": true\n  },\n  \"include\": [\n    \"src/**/*.ts\"\n  ]\n}\n",
