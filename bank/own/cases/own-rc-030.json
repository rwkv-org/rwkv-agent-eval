{
  "id": "own-rc-030",
  "category": "查找阅读-代码",
  "files": {
    "bin/fetch.sh": "#!/bin/sh\nset -eu\n. ./lib/backoff.sh\nretry_delay \"${1:-1}\"\n",
    "lib/backoff.sh": "retry_delay() {\n    attempt=$1\n    delay=$((attempt * 7))\n    if [ \"$delay\" -gt 28 ]; then delay=28; fi\n    printf '%s\\n' \"$delay\"\n}\nlinear_delay() {\n    printf '%s\\n' \"$(($1 * 7))\"\n}\n",
    "lib/backoff-old.sh": "retry_delay() {\n    printf '%s\\n' \"$(($1 * 3))\"\n}\n",
    "config/store.env": "OBJECT_REGION=west-2\n",
    ".ci/check-backoff.sh": "#!/bin/sh\nset -eu\n. ./lib/backoff.sh\ncheck_delay_cap() {\n    value=$(retry_delay 9)\n    [ \"$value\" -eq 28 ]\n}\ncheck_delay_cap\n",
    ".ci/check-linear.sh": "#!/bin/sh\nset -eu\n. ./lib/backoff.sh\n[ \"$(linear_delay 9)\" -eq 63 ]\n",
    "README.md": "# object-store-retry\n\nSmall service for object store retry.\n\nOperational entry: `bin/fetch.sh`. Paths are relative to the project root.\n"
  },
