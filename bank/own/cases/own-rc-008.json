{
  "id": "own-rc-008",
  "category": "查找阅读-代码",
  "files": {
    "bin/upload.sh": "#!/bin/sh\nset -eu\n. ./conf/upload.env\n. ./lib/remote.sh\narchive_upload() { send_archive \"$1\" \"$ARCHIVE_BUCKET\"; }\narchive_upload \"$@\"\n",
    "lib/remote.sh": "send_archive() {\n    printf 'PUT %s %s\\n' \"$2\" \"$1\"\n}\n",
    "lib/remote-old.sh": "send_archive() {\n    printf 'COPY cold-backup %s\\n' \"$1\"\n}\n",
    "conf/upload.env": "ARCHIVE_BUCKET=pg-archive-eu3\n",
    "conf/upload-old.env": "ARCHIVE_BUCKET=pg-archive-eu1\n",
    "docs/migration.md": "# Archive transport\nThe COPY transport was retained for rollback on older hosts.\n",
    "README.md": "# postgres-archive-upload\n\nSmall service for postgres archive upload.\n\nOperational entry: `bin/upload.sh`. Paths are relative to the project root.\n"
  },
