  "category": "查找阅读-代码",
  "files": {
    "go.mod": "module tundra-cache-cli\n\ngo 1.22\n",
    "cmd/tundra/main.go": "package main\nimport (\"fmt\"; \"os\"; \"tundra-cache-cli/internal/cli\")\nfunc main() {\n    names := cli.Names(false)\n    if len(os.Args) != 2 { fmt.Println(\"command required\"); return }\n    run, ok := names[os.Args[1]]\n    if !ok { fmt.Println(\"unknown command\"); return }\n    run()\n}\n",
    "internal/cli/table.go": "package cli\ntype Command struct {\n    Name string\n    Aliases []string\n    Run func()\n    Admin bool\n}\nfunc Commands() []Command {\n    return []Command{\n        {\"status\", []string{\"inspect\", \"st\"}, showStatus, false},\n        {\"sync\", []string{\"pull\"}, syncCache, false},\n        {\"doctor\", nil, diagnose, false},\n        {\"prune\", []string{\"gc\", \"trim\"}, pruneCache, true},\n    }\n}\nfunc Names(admin bool) map[string]func() {\n    result := map[string]func(){}\n    for _, cmd := range Commands() {\n        if cmd.Admin && !admin { continue }\n        result[cmd.Name] = cmd.Run\n        for _, alias := range cmd.Aliases { result[alias] = cmd.Run }\n    }\n    return result\n}\n",
    "internal/cli/actions.go": "package cli\nimport \"fmt\"\nfunc showStatus() { fmt.Println(\"cache online\") }\nfunc syncCache() { fmt.Println(\"sync queued\") }\nfunc diagnose() { fmt.Println(\"cache healthy\") }\nfunc pruneCache() { fmt.Println(\"prune queued\") }\n",
    "docs/commands.md": "# Tundra CLI\nAliases are accepted as command names. Administrative maintenance is disabled in the ordinary entry point.\n",
    "Makefile": ".PHONY: build\nbuild:\n\tgo build -o dist/tundra ./cmd/tundra\n",
    "README.md": "# tundra-cache-cli\n\n路径均相对于仓库根目录。运维入口和库函数分开维护。\n"
  },
