{
  "id": "own-rc-055",
  "category": "查找阅读-代码",
  "files": {
    ".github/workflows/packages.yml": "name: Build packages\non:\n  push:\njobs:\n  packages:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        os: [alpine, debian, rocky]\n        arch: [amd64, arm64]\n        channel: [stable, edge]\n        exclude:\n          - os: rocky\n            arch: arm64\n          - os: debian\n            channel: edge\n        include:\n          - os: alpine\n            arch: riscv64\n            channel: edge\n    steps:\n      - uses: actions/checkout@v4\n      - run: bash scripts/package.sh\n        env:\n          TARGET_OS: ${{ matrix.os }}\n          TARGET_ARCH: ${{ matrix.arch }}\n          CHANNEL: ${{ matrix.channel }}\n  metadata:\n    runs-on: ubuntu-latest\n    steps:\n      - run: echo publish-metadata\n",
    "scripts/package.sh": "#!/bin/bash\nset -eu\nprintf 'package %s %s %s\\n' \"$TARGET_OS\" \"$TARGET_ARCH\" \"$CHANNEL\"\n",
    "packaging/channels.yml": "stable:\n  retention: 30\nedge:\n  retention: 7\n",
    "docs/builds.md": "# Package builds\nThe packages job expands OS, architecture and channel. Metadata is a separate job.\n",
    "Makefile": ".PHONY: package\npackage:\n\tbash scripts/package.sh\n",
    "README.md": "# alpine-package-matrix\n\nOperational paths are relative to the repository root. Read the entry point before following helpers.\n"
  },
