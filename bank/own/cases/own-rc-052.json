    "lib/window.sh": "resolve_window() {\n    : \"${DRAIN_WINDOW:=29}\"\n    if [ \"$DRAIN_PROFILE\" = \"maintenance\" ]; then\n        source config/maintenance.env\n    fi\n}\n",
    "config/drain.env": "DRAIN_PROFILE=maintenance\nDRAIN_WINDOW=83\n",
    "config/maintenance.env": "DRAIN_WINDOW=137\n",
    "config/daytime.env": "DRAIN_WINDOW=41\n",
    "docs/runbook.md": "# Drain window\nRun bin/drain.sh from the root. The printed integer is seconds before disconnecting clients.\n",
