    "Makefile": ".PHONY: bundle clean inspect\n.PHONY: inspect publish verify\nbundle: dist/assets.txt\ndist/assets.txt: config/assets.list\n\tbash scripts/bundle.sh\nclean:\n\trm -rf dist\ninspect:\n\tcat config/assets.list\npublish: bundle\n\tbash scripts/publish.sh\nverify:\n\tbash scripts/verify.sh\n",
    "scripts/bundle.sh": "#!/bin/bash\nset -eu\nmkdir -p dist\ncp config/assets.list dist/assets.txt\n",
