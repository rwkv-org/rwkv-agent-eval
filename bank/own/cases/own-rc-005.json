  "files": {
    "src/server.py": "from .routes import PUBLIC_ROUTES\nfrom .admin import ADMIN_ROUTES\n\ndef mounted_routes(env):\n    routes = list(PUBLIC_ROUTES)\n    if env.get(\"BIKE_ADMIN\") == \"enabled\":\n        routes.extend(ADMIN_ROUTES)\n    return routes\n",
    "src/routes.py": "PUBLIC_ROUTES = [\n    (\"GET\", \"/stations\"),\n    (\"GET\", \"/stations/{id}\"),\n    (\"POST\", \"/rentals\"),\n    (\"DELETE\", \"/rentals/{id}\"),\n]\n",
