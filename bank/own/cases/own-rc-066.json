    "config/guard.mk": "override RELEASE_TRACK := guarded\n",
    "config/storage.mk": "EXPORT_BUCKET := $(EXPORT_BUCKET)-east\n",
    "scripts/deploy.sh": "#!/bin/bash\nset -eu\nprintf 'upload-bucket=%s\\n' \"$EXPORT_BUCKET\"\n",
