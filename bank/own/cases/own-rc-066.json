  "files": {
    "Makefile": "RELEASE_TRACK ?= standard\ninclude config/site.mk\ninclude config/guard.mk\nEXPORT_BUCKET = $(RELEASE_TRACK)-releases\ninclude config/storage.mk\nexport RELEASE_TRACK EXPORT_BUCKET\n.PHONY: deploy show\ndeploy:\n\tbash scripts/deploy.sh\nshow:\n\t@printf '%s\\n' \"$(EXPORT_BUCKET)\"\n",
