{"case": "own-se-089", "search_mode": "replay", "sources": ["deepseek-search 2026-11-06T13:50:13.388652+00:00", "web_tool.py curl 2026-11-06T13:59:49.865764+00:00"], "complete": true, "pages": [{"url": "http://news.cctv.com/2019/10/26/ARTIiWUofGiuhL0V4LzHgcRC191026.shtml", "finalUrl": "http://news.cctv.com/2019/10/26/ARTIiWUofGiuhL0V4LzHgcRC191026.shtml", "at": "2026-11-06T13:59:49.865764+00:00", "status": 200, "contentType": "text/html", "bytes": 37012, "body": "                                                                     <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n    <html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n    <head>\r\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0, minimun-scale=1.0,maximum-scale=1.0,user-scalable=no\">\r\n    <meta name=\"filetype\" content=\"1\"> \r\n    <meta name=\"publishedtype\" content=\"1\"> \r\n    <meta name=\"pagetype\" content=\"1\"> \r\n    \r\n        <meta name=\"author\" content=\"田宏\"> \r\n        <meta name=\"source\" content=\"人民日报\"> \r\n    \r\n    \r\n    \r\n    <title>新中国的“第一”之第一部综合性百科全书_新闻频道_央视网(cctv.com)</title>\r\n    <meta name=\"catalogs\" content=\"PAGE1357526812000160\"> \r\n    <meta name=\"contentid\" content=\"ARTIiWUofGiuhL0V4LzHgcRC191026\">\r\n    <meta name=keywords content=\"中国大百科全书 第一 中国儿童百科全书\">\r\n    <meta name=\"spm-id\" content=\"C73544894212\">\r\n    <meta name=description content=\"1993年8月，74卷《中国大百科全书》（第一版）全部出齐，覆盖社会科学、文学艺术、自然科学、工程技术等66个学科，共收77859个条目，约12568万字。这是中国人编纂的第一部综合性百科全书，结束了近代以来中国没有百科全书的历史。\">\r\n    <meta property=\"og:title\" content=\"新中国的“第一”之第一部综合性百科全书\" />\r\n<meta property=\"og:image\" content=\"//p1.img.cctvpic.com/photoAlbum/templet/common/DEPA1502157896010276/newslog200.jpg\" />\r\n<meta property=\"og:description\" content=\"1993年8月，74卷《中国大百科全书》（第一版）全部出齐，覆盖社会科学、文学艺术、自然科学、工程技