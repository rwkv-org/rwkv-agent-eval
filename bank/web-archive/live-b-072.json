{"case": "live-b-072", "search_mode": "unavailable", "sources": ["overnight-20261106-extra-web-17/traj/live-b-072-t1/snapshots.jsonl"], "complete": true, "pages": [{"url": "https://www.postgresql.org/docs/current/tutorial-agg.html", "finalUrl": "https://www.postgresql.org/docs/current/tutorial-agg.html", "at": "2026-11-05T22:03:19.606Z", "status": 200, "contentType": "text/html; charset=utf-8", "bytes": 20657, "body": "<!doctype html>\n<html lang=\"en\">\n <head>\n  <title>PostgreSQL: Documentation: 18: 2.7. Aggregate Functions</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n  <meta http-equiv=\"Content-Type\" content=\"text/xhtml; charset=utf-8\" />\n   \n  <meta name=\"theme-color\" content=\"#336791\"/>\n  <meta name=\"copyright\" content=\"The PostgreSQL Global Development Group\" />\n  <meta property=\"og:url\" content=\"https://www.postgresql.org/docs/18/tutorial-agg.html\" />\n  <meta property=\"og:type\" content=\"article\" />\n\n  <meta property=\"article:published_time\" content=\"2026-08-13T12:52:54.741344\" />\n  <meta property=\"og:image\" content=\"https://www.postgresql.org/media/img/about/press/elephant.png\" />\n  <meta property=\"og:title\" content=\"2.7. Aggregate Functions\" />\n  <meta property=\"og:description\" content=\"2.7.&amp;nbsp;Aggregate Functions # Like most other relational database products, PostgreSQL supports aggregate functions. An aggregate function computes a single result …\" />\n  <meta property=\"og:site_name\" content=\"PostgreSQL Documentation\" />\n  <link href=\"/media/css/fontawesome.css?e5d475b4\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"/media/css/bootstrap-4.4.1.min.css\">\n  <link rel=\"shortcut icon\" href=\"/favicon.ico\" />\n  \n  <link rel=\"stylesheet\" type=\"text/css\" href=\"/dyncss/base.css?e5d475b4\">\n\n  <script src=\"/media/js/theme.js?e5d475b4\"></script>\n\n  \n\n\n  <link rel=\"canonical\" href=\"https://www.postgresql.org/docs/curre