a href=\"/docs/17/sql-set-constraints.html\" title=\"PostgreSQL 17 - SET CONSTRAINTS\" >17</a>\n                        \n                      \n                         / \n                        \n                          <a href=\"/docs/16/sql-set-constraints.html\" title=\"PostgreSQL 16 - SET CONSTRAINTS\" >16</a>\n                        \n                      \n                         / \n                        \n                          <a href=\"/docs/15/sql-set-constraints.html\" title=\"PostgreSQL 15 - SET CONSTRAINTS\" >15</a>\n                        \n                      \n                         / \n                        \n                          <a href=\"/docs/14/sql-set-constraints.html\" title=\"PostgreSQL 14 - SET CONSTRAINTS\" >14</a>\n                        \n                      \n                  </div>\n                </div>\n              \n              \n                <div class=\"row\">\n                  <div class=\"col\">\n                    Development Versions:\n                    \n                      \n                      <a href=\"/docs/19/sql-set-constraints.html\" title=\"PostgreSQL 19 - SET CONSTRAINTS\"  rel=\"nofollow\">19</a>\n                    \n                       / \n                      <a href=\"/docs/devel/sql-set-constraints.html\" title=\"PostgreSQL devel - SET CONSTRAINTS\"  rel=\"nofollow\">devel</a>\n                    \n                  </div>\n                </div>\n              \n              \n                <div class=\"row\">\n                  <div class=\"col-12\">\n                    Unsupported versions:\n                    \n                      \n                      <a href=\"/docs/13/sql-set-constraints.html\" title=\"PostgreSQL 13 - SET CONSTRAINTS\"  rel=\"nofollow\">13</a>\n                    \n                       / \n                      <a href=\"/docs/12/sql-set-constraints.html\" title=\"PostgreSQL 12 - SET CONSTRAINTS\"  rel=\"nofollow\">12</a>\n